{
  "openapi": "3.1.0",
  "info": {
    "title": "SAPS 3 global hospital mortality API",
    "description": "Convert a precomputed SAPS 3 score to a global-model estimate of in-hospital mortality. Legacy audit endpoints are demonstrations only. Runtime /openapi.json is canonical; this is a lightweight public API overview.",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Application health status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory demonstration counters (JSON)",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy synthetic-threshold demonstration (not SAPS 3)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy mock-chat demonstration (not clinical)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/mortality": {
      "post": {
        "summary": "Convert a precomputed SAPS 3 admission score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "saps3_score"
                ],
                "properties": {
                  "saps3_score": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 217
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Global-model estimated in-hospital mortality and model metadata"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Serve the standalone browser calculator",
        "responses": {
          "200": {
            "description": "HTML calculator"
          }
        }
      }
    }
  }
}
